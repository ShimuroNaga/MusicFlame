<?xml version="1.0" encoding="utf-8"?>
<!--
    Rediseño (ago 2026) de la variante de "letra completa" — reemplaza por
    completo el diseño anterior (el del commit que expandía el widget al
    activarse). Ya NO depende del tamaño físico del widget en el home screen:
    se fuerza este layout fijo apenas el usuario activa el switch "Widget
    cuadrado de letra completa" en Ajustes > Lyrics (ver
    MusicFlameWidgetProvider.buildRemoteViews, que ahora devuelve este layout
    directo en vez de agregarlo al mapa de tamaños responsivo). Al desactivar
    el switch, el widget vuelve a comportarse como siempre (compact/wide).

        [        Título de la canción, centrado         ]
        [ Letra (mín. 3 líneas) ]  [ Play/Pause | Siguiente ]
                                   [ Carátula    | Anterior  ]
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_music_flame_background"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:padding="10dp">

    <!-- TÍTULO: fila propia, ancho completo, centrado -->
    <TextView
        android:id="@+id/widget_song_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:singleLine="true"
        android:text="@string/widget_no_song"
        android:textColor="#FFFFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        android:shadowColor="#CC000000"
        android:shadowDx="0"
        android:shadowDy="1"
        android:shadowRadius="3" />

    <!-- FILA INFERIOR: Letra (izquierda) | Grid 2x2 de controles+carátula (derecha) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <!-- LETRA: mínimo 3 líneas visibles, multilinea con wrap, SIN ellipsize.
             Se actualiza entera con setTextViewText (mismo mecanismo que las
             demás variantes), nunca hace scroll ni animación. -->
        <TextView
            android:id="@+id/widget_lyrics_full_block"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginEnd="10dp"
            android:ellipsize="none"
            android:gravity="start|top"
            android:includeFontPadding="false"
            android:minLines="3"
            android:maxLines="4"
            android:text="@string/widget_select_song"
            android:textColor="#E6FFFFFF"
            android:textSize="18sp"
            android:lineSpacingExtra="3dp"
            android:shadowColor="#CC000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="3" />

        <!-- GRID 2x2 cuadrado: Play/Pause (sup. izq.) | Siguiente (sup. der.)
                                Carátula    (inf. izq.) | Anterior  (inf. der.) -->
        <LinearLayout
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:background="@drawable/widget_album_art_background"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <ImageButton
                    android:id="@+id/widget_play_pause"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/widget_button_background"
                    android:contentDescription="@string/widget_play_pause_desc"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_widget_play" />

                <LinearLayout
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="#33FFFFFF"
                    android:orientation="vertical" />

                <ImageButton
                    android:id="@+id/widget_next_or_prev"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/widget_button_background"
                    android:contentDescription="@string/widget_next_desc"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_widget_skip_next" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#33FFFFFF"
                android:orientation="vertical" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/widget_album_art"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:scaleType="centerCrop"
                    android:src="@drawable/ic_widget_music_placeholder"
                    android:contentDescription="@string/widget_album_art_desc" />

                <LinearLayout
                    android:layout_width="1dp"
                    android:layout_height="match_parent"
                    android:background="#33FFFFFF"
                    android:orientation="vertical" />

                <ImageButton
                    android:id="@+id/widget_previous"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/widget_button_background"
                    android:contentDescription="@string/widget_previous_desc"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_widget_skip_previous" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

</LinearLayout>
