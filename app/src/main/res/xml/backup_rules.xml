<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <exclude domain="sharedpref" path="playlists.xml"/>
    <exclude domain="sharedpref" path="settings.xml"/>
    <!-- Ajustes en DataStore (antes settings.xml): se siguen excluyendo del respaldo -->
    <exclude domain="file" path="datastore/settings_store.preferences_pb"/>
    <exclude domain="sharedpref" path="chat_history.xml"/>
    <exclude domain="sharedpref" path="ai_online_secure.xml"/>
    <exclude domain="sharedpref" path="ai_online_usage.xml"/>
    <!-- Base Room (playlists por id de MediaStore): igual que playlists.xml, no se restaura en otro equipo -->
    <exclude domain="database" path="musicflame.db"/>
    <exclude domain="database" path="musicflame.db-wal"/>
    <exclude domain="database" path="musicflame.db-shm"/>
</full-backup-content>