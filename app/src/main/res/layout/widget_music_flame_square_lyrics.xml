<?xml version="1.0" encoding="utf-8"?>
<!--
    Variante CUADRADA de letra completa (180x180dp), opt-in vía el switch
    "Widget cuadrado de letra completa" en Ajustes > Lyrics (independiente del
    switch de "Letra en vivo en el widget" — ver SettingsRepository.kt).

        [ Play/Pause ]     [ Título de la canción ]     [ Siguiente ]
        [ Carátula   ]     [   Bloque de letra completa  ]  [ Anterior ]

    La letra acá NO se corta ni hace scroll: es un bloque de texto multilinea
    con wrap (sin ellipsize), igual de "vivo" que las otras variantes (mismo
    tick de 400ms + onPositionDiscontinuity), pero mostrando varias líneas de
    contexto en vez de 1-3 truncadas. Se eligió este enfoque en vez de scroll
    automático letra por letra porque RemoteViews no tiene forma confiable de
    animar texto: el marquee nativo depende de foco/selección que un widget de
    home screen no garantiza, y simular el scroll a mano requeriría medir el
    texto renderizado (algo que RemoteViews no expone). Un swap de texto
    (setTextViewText) en un bloque que crece con wrap es el mismo mecanismo
    que ya usan las variantes wide/compact con letra, así que es 100%
    compatible sin trucos.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_music_flame_background"
    android:orientation="vertical"
    android:padding="10dp">

    <!-- FILA SUPERIOR: Play/Pause (esquina sup. izq.) | Título | Siguiente (esquina sup. der.) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="44dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/widget_play_pause"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/widget_button_background"
            android:contentDescription="@string/widget_play_pause_desc"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_play" />

        <TextView
            android:id="@+id/widget_song_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="end"
            android:gravity="center"
            android:maxLines="1"
            android:singleLine="true"
            android:text="@string/widget_no_song"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:shadowColor="#CC000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="3" />

        <ImageButton
            android:id="@+id/widget_next_or_prev"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/widget_button_background"
            android:contentDescription="@string/widget_next_desc"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_skip_next" />
    </LinearLayout>

    <!-- FILA INFERIOR (fills el resto): Carátula (esquina inf. izq.) | Letra completa | Anterior (esquina inf. der.) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="8dp"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/widget_album_art"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="bottom"
            android:background="@drawable/widget_album_art_background"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_widget_music_placeholder"
            android:contentDescription="@string/widget_album_art_desc" />

        <!-- Bloque de letra: multilinea con wrap, SIN ellipsize, crece hacia
             abajo llenando todo el espacio disponible. Se actualiza entero
             con setTextViewText cada vez que cambia la línea activa (mismo
             tick/onPositionDiscontinuity de MusicPlaybackService), nunca hace
             scroll ni animación, solo swap de texto. -->
        <TextView
            android:id="@+id/widget_lyrics_full_block"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:layout_marginEnd="8dp"
            android:ellipsize="none"
            android:gravity="center"
            android:includeFontPadding="false"
            android:maxLines="9"
            android:text="@string/widget_select_song"
            android:textColor="#E6FFFFFF"
            android:textSize="13sp"
            android:lineSpacingExtra="2dp"
            android:shadowColor="#CC000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="3" />

        <ImageButton
            android:id="@+id/widget_previous"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:layout_gravity="bottom"
            android:background="@drawable/widget_button_background"
            android:contentDescription="@string/widget_previous_desc"
            android:padding="9dp"
            android:scaleType="fitCenter"
            android:src="@drawable/ic_widget_skip_previous" />
    </LinearLayout>

</LinearLayout>
