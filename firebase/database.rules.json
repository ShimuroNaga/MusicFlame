{
  "rules": {
    ".read": false,
    ".write": false,

    "rooms": {
      "$code": {
        // El anfitrión (meta/hostUid) puede escribir en toda su sala (también borrarla).
        // Cualquiera con sesión puede CREAR una sala que todavía no existe.
        ".write": "auth != null && (!data.exists() || data.child('meta/hostUid').val() === auth.uid)",

        "meta": {
          // Hay que leer meta ANTES de ser miembro (así se comprueba que la sala existe al unirse).
          ".read": "auth != null",

          // Ascenso automático: si el anfitrión está desconectado, un propietario puede ponerse a sí mismo.
          "hostUid": {
            ".write": "auth != null && data.exists() && newData.val() === auth.uid && root.child('rooms/' + $code + '/owners/' + auth.uid).exists() && root.child('rooms/' + $code + '/members/' + data.val() + '/online').val() !== true"
          },

          // Quién controla la música: tomarlo si está libre, pasarlo/soltarlo si es mío,
          // o relevar a un controlador desconectado. Siempre solo propietarios.
          "controllerUid": {
            ".write": "auth != null && root.child('rooms/' + $code + '/owners/' + auth.uid).exists() && ((!data.exists() && newData.val() === auth.uid) || (data.val() === auth.uid && (!newData.exists() || root.child('rooms/' + $code + '/owners/' + newData.val()).exists())) || (data.exists() && newData.val() === auth.uid && root.child('rooms/' + $code + '/members/' + data.val() + '/online').val() !== true))"
          }
        },

        "members": {
          ".read": "auth != null && root.child('rooms/' + $code + '/members/' + auth.uid).exists()",
          // Cada quien escribe lo suyo, salvo que el anfitrión lo haya expulsado de esta sala.
          "$uid": {
            ".write": "auth != null && $uid === auth.uid && !root.child('rooms/' + $code + '/banned/' + $uid).exists()",
            "name": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "avatar": { ".validate": "newData.isString() && newData.val().length <= 60000" }
          }
        },

        // Expulsados de ESTA sala: solo el anfitrión los añade (permiso de la sala); cada quien puede
        // leer únicamente si él mismo está expulsado (así la app avisa en vez de fallar en silencio).
        "banned": {
          "$uid": { ".read": "auth != null && $uid === auth.uid" }
        },

        // Propietarios: los añade/quita el anfitrión; cada quien puede renunciar a lo suyo.
        "owners": {
          ".read": "auth != null && root.child('rooms/' + $code + '/members/' + auth.uid).exists()",
          "$uid": { ".write": "auth != null && $uid === auth.uid && !newData.exists()" }
        },

        // Lo que suena: solo lo escribe el controlador actual.
        "state": {
          ".read": "auth != null && root.child('rooms/' + $code + '/members/' + auth.uid).exists()",
          ".write": "auth != null && root.child('rooms/' + $code + '/meta/controllerUid').val() === auth.uid"
        },

        // Lista de espera: un propietario añade las suyas y quita las suyas;
        // cualquier propietario puede cambiar el orden (campo pos).
        "queue": {
          ".read": "auth != null && root.child('rooms/' + $code + '/members/' + auth.uid).exists()",
          "$id": {
            ".write": "auth != null && root.child('rooms/' + $code + '/owners/' + auth.uid).exists() && ((!data.exists() && newData.child('addedBy').val() === auth.uid) || data.child('addedBy').val() === auth.uid)",
            ".validate": "newData.hasChildren(['title', 'addedBy', 'addedByName', 'pos'])",
            "title": { ".validate": "newData.isString() && newData.val().length <= 200" },
            "artist": { ".validate": "newData.isString() && newData.val().length <= 200" },
            "duration": { ".validate": "newData.isNumber()" },
            "addedByName": { ".validate": "newData.isString() && newData.val().length <= 60" },
            "pos": {
              ".write": "auth != null && root.child('rooms/' + $code + '/owners/' + auth.uid).exists() && data.exists()",
              ".validate": "newData.isNumber()"
            }
          }
        },

        // Chat de la sala (solo texto). Solo lo leen los miembros de ESA sala.
        //  - Escribir: un miembro manda SUS mensajes (uid = el suyo) si no está expulsado del chat.
        //    Los avisos del sistema (type = 'sys': "X fue expulsado/perdonado") solo los pueden poner propietarios.
        //  - Borrar: cada quien borra los suyos; los propietarios pueden borrar cualquiera (no los avisos).
        //  - Todo se borra solo cuando el anfitrión cierra la sala (sin historial).
        "chat": {
          ".read": "auth != null && root.child('rooms/' + $code + '/members/' + auth.uid).exists()",
          "$id": {
            ".write": "auth != null && root.child('rooms/' + $code + '/members/' + auth.uid).exists() && ((!data.exists() && newData.child('uid').val() === auth.uid && ((newData.child('type').val() === 'sys' && root.child('rooms/' + $code + '/owners/' + auth.uid).exists()) || (!newData.child('type').exists() && !root.child('rooms/' + $code + '/chatMuted/' + auth.uid).exists()))) || (data.exists() && !newData.exists() && data.child('type').val() !== 'sys' && (data.child('uid').val() === auth.uid || root.child('rooms/' + $code + '/owners/' + auth.uid).exists())))",
            ".validate": "newData.hasChildren(['uid', 'at', 'text']) && ((newData.child('type').val() === 'sys' && newData.child('event').exists()) || (!newData.child('type').exists() && !newData.child('event').exists())) && (!newData.child('replyId').exists() || (newData.child('type').val() !== 'sys' && newData.hasChildren(['replyId', 'replyUid', 'replyName', 'replyText'])))",
            "uid": { ".validate": "newData.isString()" },
            "name": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "text": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 300" },
            "at": { ".validate": "newData.isNumber()" },
            "type": { ".validate": "newData.val() === 'sys'" },
            "event": { ".validate": "newData.val() === 'mute' || newData.val() === 'unmute'" },
            "replyId": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 64" },
            "replyUid": { ".validate": "newData.isString() && newData.val().length <= 128" },
            "replyName": { ".validate": "newData.isString() && newData.val().length <= 40" },
            "replyText": { ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 100" },
            "$other": { ".validate": false }
          }
        },

        // Expulsados del CHAT (siguen en la sala escuchando, solo no pueden escribir).
        // Los lee cualquier miembro (para avisarte); solo un propietario expulsa/perdona,
        // y nunca a otro propietario.
        "chatMuted": {
          ".read": "auth != null && root.child('rooms/' + $code + '/members/' + auth.uid).exists()",
          "$uid": {
            ".write": "auth != null && root.child('rooms/' + $code + '/owners/' + auth.uid).exists() && !root.child('rooms/' + $code + '/owners/' + $uid).exists()",
            ".validate": "newData.val() === true"
          }
        },

        // Votos para saltar: cada propietario escribe solo el suyo; el controlador puede limpiarlos todos.
        "skipVotes": {
          ".read": "auth != null && root.child('rooms/' + $code + '/members/' + auth.uid).exists()",
          ".write": "auth != null && root.child('rooms/' + $code + '/meta/controllerUid').val() === auth.uid",
          "$uid": {
            ".write": "auth != null && $uid === auth.uid && root.child('rooms/' + $code + '/owners/' + auth.uid).exists()",
            ".validate": "newData.isString()"
          }
        }
      }
    }
  }
}
