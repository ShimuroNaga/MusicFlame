<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.READ_MEDIA_AUDIO"/>
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE" tools:ignore="ScopedStorage"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK" />
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!-- Requerido por android.media.audiofx.Visualizer, aunque no grabemos nada del micrófono -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.MusicFlame">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:label="@string/app_name"
            android:launchMode="singleTask"
            android:theme="@style/Theme.MusicFlame">

            <!-- Reproductor de audio: mimeType audio/* (cubre la mayoría de gestores
                 de archivos modernos y de content://) -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:mimeType="audio/*" />
            </intent-filter>

            <!-- Respaldo por extensión para gestores de archivos viejos que abren
                 con scheme file:// (o content://) y mandan el mimeType vacío o mal
                 armado. A propósito NO se declara mimeType acá: si el intent no
                 trae type (común en file://), un filtro que sí lo declare puede no
                 matchear; acá solo se evalúa scheme + host + patrón de path. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="file" />
                <data android:scheme="content" />
                <data android:host="*" />
                <data android:pathPattern=".*\\.mp3" />
                <data android:pathPattern=".*\\.flac" />
                <data android:pathPattern=".*\\.wav" />
                <data android:pathPattern=".*\\.ogg" />
                <data android:pathPattern=".*\\.m4a" />
                <data android:pathPattern=".*\\.aac" />
                <data android:pathPattern=".*\\.opus" />
                <data android:pathPattern=".*\\.wma" />
            </intent-filter>
        </activity>

        <!-- Alias: icono Original (activo por defecto) -->
        <activity-alias
            android:name=".IconDefault"
            android:targetActivity=".MainActivity"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher"
            android:label="@string/app_name"
            android:theme="@style/Theme.MusicFlame">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Alias: icono Brillante -->
        <activity-alias
            android:name=".IconBrilliant"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_brilliant"
            android:roundIcon="@mipmap/ic_launcher_brilliant"
            android:label="@string/app_name"
            android:theme="@style/Theme.MusicFlame">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Alias: icono Pixel (easter egg: cambia también el nombre a PixelFlame) -->
        <activity-alias
            android:name=".IconPixel"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_pixel"
            android:roundIcon="@mipmap/ic_launcher_pixel"
            android:label="@string/app_name_pixel"
            android:theme="@style/Theme.MusicFlame">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Alias: icono Cookies -->
        <activity-alias
            android:name=".IconCookies"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_cookies"
            android:roundIcon="@mipmap/ic_launcher_cookies"
            android:label="@string/app_name_cookies"
            android:theme="@style/Theme.MusicFlame">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Alias: icono RemixFlame (cambia también el nombre a RemixFlame) -->
        <activity-alias
            android:name=".IconRemixFlame"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_remixflame"
            android:roundIcon="@mipmap/ic_launcher_remixflame"
            android:label="@string/app_name_remixflame"
            android:theme="@style/Theme.MusicFlame">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Alias: icono DemonMusic (cambia también el nombre a DemonMusic) -->
        <activity-alias
            android:name=".IconDemonMusic"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_demonmusic"
            android:roundIcon="@mipmap/ic_launcher_demonmusic"
            android:label="@string/app_name_demonmusic"
            android:theme="@style/Theme.MusicFlame">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <!-- Alias: icono Gris -->
        <activity-alias
            android:name=".IconGray"
            android:targetActivity=".MainActivity"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_gray"
            android:roundIcon="@mipmap/ic_launcher_gray"
            android:label="@string/app_name"
            android:theme="@style/Theme.MusicFlame">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>

        <service
            android:name=".data.MusicPlaybackService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="true">
            <intent-filter>
                <action android:name="androidx.media3.session.MediaSessionService" />
            </intent-filter>
        </service>

        <receiver
            android:name=".widget.MusicFlameWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/musicflame_widget_info" />
        </receiver>

        <receiver
            android:name=".widget.WidgetActionReceiver"
            android:exported="false" />

        <!-- Widget "Vinilo" (catálogo cosmético punto 5): funda + disco giratorio -->
        <receiver
            android:name=".widget.MusicFlameVinylWidgetProvider"
            android:exported="true">
            <intent-filter>
                <action android:name="android.appwidget.action.APPWIDGET_UPDATE" />
            </intent-filter>
            <meta-data
                android:name="android.appwidget.provider"
                android:resource="@xml/musicflame_vinyl_widget_info" />
        </receiver>

    </application>
</manifest>