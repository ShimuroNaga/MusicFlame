<?xml version="1.0" encoding="utf-8"?>
<!--
    Tamaño: 2x2 celdas por defecto, redimensionable hacia abajo hasta 1x1
    (fórmula estándar de Android para el ancho/alto mínimo de N celdas:
    N*70 - 30 dp). maxResize se deja igual a min (2x2) para que el usuario
    no pueda agrandarlo más allá de esas 4 celdas, tal como se pidió.
-->
<appwidget-provider xmlns:android="http://schemas.android.com/apk/res/android"
    android:initialLayout="@layout/widget_music_flame_vinyl"
    android:minWidth="110dp"
    android:minHeight="110dp"
    android:minResizeWidth="40dp"
    android:minResizeHeight="40dp"
    android:maxResizeWidth="110dp"
    android:maxResizeHeight="110dp"
    android:targetCellWidth="2"
    android:targetCellHeight="2"
    android:resizeMode="horizontal|vertical"
    android:widgetCategory="home_screen"
    android:previewLayout="@layout/widget_music_flame_vinyl"
    android:description="@string/widget_music_flame_vinyl_description"
    android:updatePeriodMillis="0" />
