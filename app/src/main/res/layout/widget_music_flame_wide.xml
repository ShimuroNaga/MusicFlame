<?xml version="1.0" encoding="utf-8"?>
<!--
    Variante ANCHA (4 celdas) del widget de MusicFlame.

    [ Carátula + nombre ]   [ Atrás ]   [ Play/Pause ]   [ Siguiente ]

    Se activa sola cuando el usuario agranda el widget más allá del tamaño
    compacto de 3 celdas (ver RemoteViews(Map<SizeF,RemoteViews>) en
    MusicFlameWidgetProvider.kt). Al haber un botón dedicado de "atrás",
    aquí el botón de "siguiente" es de un solo propósito (sin doble toque):
    no hace falta el truco de la variante compacta porque ya sobra espacio
    para un botón propio.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_music_flame_background"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="10dp"
    android:paddingTop="8dp"
    android:paddingEnd="6dp"
    android:paddingBottom="8dp">

    <!-- CARÁTULA (siempre cuadrada) -->
    <ImageView
        android:id="@+id/widget_album_art"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/widget_album_art_background"
        android:scaleType="centerCrop"
        android:src="@drawable/ic_widget_music_placeholder"
        android:contentDescription="@string/widget_album_art_desc" />

    <!-- NOMBRE DE LA CANCIÓN / ARTISTA -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="4dp"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_song_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            android:text="@string/widget_no_song"
            android:textColor="#FFFFFFFF"
            android:textSize="13sp"
            android:textStyle="bold"
            android:shadowColor="#CC000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="3" />

        <TextView
            android:id="@+id/widget_song_artist"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            android:text="@string/widget_select_song"
            android:textColor="#E6FFFFFF"
            android:textSize="11sp"
            android:shadowColor="#CC000000"
            android:shadowDx="0"
            android:shadowDy="1"
            android:shadowRadius="3" />
    </LinearLayout>

    <!-- ANTERIOR (botón propio, solo existe en esta variante ancha) -->
    <ImageButton
        android:id="@+id/widget_previous"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="2dp"
        android:background="@drawable/widget_button_background"
        android:contentDescription="@string/widget_previous_desc"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_widget_skip_previous" />

    <!-- PLAY / PAUSE -->
    <ImageButton
        android:id="@+id/widget_play_pause"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="2dp"
        android:background="@drawable/widget_button_background"
        android:contentDescription="@string/widget_play_pause_desc"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_widget_play" />

    <!-- SIGUIENTE (aquí de un solo propósito, sin doble toque) -->
    <ImageButton
        android:id="@+id/widget_next_or_prev"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:background="@drawable/widget_button_background"
        android:contentDescription="@string/widget_next_desc"
        android:padding="8dp"
        android:scaleType="fitCenter"
        android:src="@drawable/ic_widget_skip_next" />

</LinearLayout>
